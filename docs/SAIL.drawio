  <diagram id="hBQ8z4gRqyx39oTWQ47W" name="Save Process">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Game Save&lt;/b&gt;&lt;br&gt;Autosave, sleep or quit calls SaveGame; DoSaveGame builds the SaveContainer" vertex="1">
          <mxGeometry height="80" width="330" x="110" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p4-s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Vanilla save loops&lt;/b&gt;&lt;br&gt;savedObjects from currentObjects[], savedPrefabs from the prefab list (one frame)" vertex="1">
          <mxGeometry height="80" width="330" x="110" y="180" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s1-s2" edge="1" parent="1" source="p4-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;" target="p4-s2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;SaveModData() hook&lt;/b&gt;&lt;br&gt;SAIL runs here, on the same snapshot the loops just used" vertex="1">
          <mxGeometry height="80" width="330" x="110" y="300" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s2-s3" edge="1" parent="1" source="p4-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;" target="p4-s3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Generate Item Index&lt;/b&gt;&lt;br&gt;One record per saved object and per item prefab in use: index, mod GUID, item ID" vertex="1">
          <mxGeometry height="80" width="330" x="110" y="420" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s3-s4" edge="1" parent="1" source="p4-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;" target="p4-s4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-s5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Save to ModData&lt;/b&gt;&lt;br&gt;One versioned JSON string under a SAIL key in GameState.modData" vertex="1">
          <mxGeometry height="80" width="330" x="110" y="540" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s4-s5" edge="1" parent="1" source="p4-s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;" target="p4-s5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-s6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;Vanilla writes the file&lt;/b&gt;&lt;br&gt;modData is copied into the container, PushBackups runs, BinaryFormatter writes slotN.save" vertex="1">
          <mxGeometry height="80" width="330" x="110" y="660" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-s5-s6" edge="1" parent="1" source="p4-s5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;" target="p4-s6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-note1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=6;" value="&lt;b&gt;First SAIL save only&lt;/b&gt;&lt;br&gt;Copy the old slotN.save once (slotN.pre-sail.save) before PushBackups, because the game keeps only five backups" vertex="1">
          <mxGeometry height="100" width="280" x="500" y="540" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-note" edge="1" parent="1" source="p4-note1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="p4-s6" value="before the write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4-note2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacingLeft=6;" value="&lt;b&gt;Pinned objects&lt;/b&gt;&lt;br&gt;Vanilla and grandfathered mods have no SAIL identity; their record is the index itself" vertex="1">
          <mxGeometry height="90" width="280" x="500" y="420" as="geometry" />
        </mxCell>
        <mxCell id="p4-e-note2" edge="1" parent="1" source="p4-note2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=default;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="p4-s4" value="">
